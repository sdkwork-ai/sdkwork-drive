/* Reference styles for the Drive upload-image mini-program component.
 * Tune spacing/tokens to the host app; keep the structural selectors. */
.drive-upload-image {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.drive-upload-image__label {
  font-size: 28rpx;
  font-weight: 500;
  color: #262626;
}

.drive-upload-image__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.drive-upload-image__item,
.drive-upload-image__add {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 2rpx dashed #d4d4d4;
  background: #fafafa;
  overflow: hidden;
}

.drive-upload-image__item--uploaded {
  border-style: solid;
  border-color: #e5e5e5;
}

.drive-upload-image__thumb {
  width: 100%;
  height: 100%;
}

.drive-upload-image__placeholder,
.drive-upload-image__add {
  color: #a3a3a3;
  font-size: 48rpx;
}

.drive-upload-image__progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
}

.drive-upload-image__progress-bar {
  height: 6rpx;
  background: #60a5fa;
  transition: width 0.2s ease;
}

.drive-upload-image__remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 28rpx;
}

.drive-upload-image__error {
  font-size: 24rpx;
  color: #dc2626;
}

.drive-upload-image__description {
  font-size: 24rpx;
  color: #737373;
}
