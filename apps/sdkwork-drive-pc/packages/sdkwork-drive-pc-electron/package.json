{
  "name": "sdkwork-drive-pc-electron",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "author": "SDKWork",
  "description": "SDKWork Drive PC Electron desktop host shell.",
  "main": "./dist-electron/src-electron/main/index.js",
  "scripts": {
    "dev:desktop": "electron .",
    "build:desktop": "node ./scripts/build-electron.mjs",
    "build:desktop:local": "node ./scripts/build-electron.mjs --debug",
    "generate:tray-icon": "node ./scripts/generate-tray-icon.mjs",
    "typecheck": "tsc --noEmit --project ./tsconfig.json"
  },
  "dependencies": {
    "sdkwork-drive-pc-core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~6.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./host": {
      "types": "./src/host/electronDesktopHost.ts",
      "import": "./src/host/electronDesktopHost.ts",
      "default": "./src/host/electronDesktopHost.ts"
    }
  }
}
