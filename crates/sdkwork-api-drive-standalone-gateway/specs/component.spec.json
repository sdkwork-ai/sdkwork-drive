  "contracts": {
    "layerRole": "runtime-gateway",
    "publicExports": [],
    "providedPorts": [],
    "requiredPorts": [
      {
        "name": "driveApiAssembly",
        "export": "sdkwork_api_drive_assembly::assemble_api_router_from_env",
        "provider": "sdkwork-api-drive-assembly"
      },
      {
        "name": "iamAppApiContribution",
        "export": "sdkwork_api_iam_assembly::assemble_app_api_contribution_with_pool",
        "provider": "sdkwork-api-iam-assembly"
      }
    ],
    "runtimeEntrypoints": [
      "src/main.rs",
      "Cargo.toml[[bin]].sdkwork-api-drive-standalone-gateway"
    ],
    "routeManifest": null,
    "sdkClients": [],
    "sdkDependencies": [],
    "permissionComposition": {},
    "dependencyApiExports": [],
    "dependencyApiSurfaces": [
      {
        "workspace": "sdkwork-iam",
        "sdkFamily": "sdkwork-iam-app-sdk",
        "apiAuthority": "sdkwork-iam-app-api",
        "surface": "app-api",
        "apiPrefixes": [
          "/app/v3/api/auth",
          "/app/v3/api/iam",
          "/app/v3/api/oauth",
          "/app/v3/api/system/iam"
        ],
        "runtimeMode": "same-origin",
        "sameOriginAllowed": true,
        "cargoDependency": "sdkwork-api-iam-assembly",
        "embeddedExecutableExport": "sdkwork_api_iam_assembly::assemble_app_api_contribution_with_pool",
        "profileCoverage": ["standalone"],
        "coverageEvidence": ["src/main.rs"]
      }
    ],
    "events": [],
    "configKeys": [
      "SDKWORK_DATABASE_URL",
      "SDKWORK_DATABASE_SCHEMA",
      "SDKWORK_DATABASE_MAX_CONNECTIONS",
      "SDKWORK_DRIVE_CONFIG_FILE",
      "SDKWORK_DRIVE_STANDALONE_GATEWAY_CONFIG",
      "SDKWORK_DRIVE_STANDALONE_GATEWAY_ENVIRONMENT",
      "SDKWORK_ENVIRONMENT",
      "SDKWORK_CORS_ALLOWED_ORIGINS"
    ]
  },
  "verification": {
    "commands": [
      "cargo check -p sdkwork-api-drive-standalone-gateway",
      "node ../sdkwork-specs/tools/audit-gateway-alignment-repo.mjs --root . --strict",
      "node ../sdkwork-specs/tools/check-process-shared-database-pool.mjs --root ."
    ]
  }
