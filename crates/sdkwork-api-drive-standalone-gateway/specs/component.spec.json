      "purpose": "Focused authored source and process-host boundaries."
    },
    {
      "file": "NAMING_SPEC.md",
      "path": "../../../sdkwork-specs/NAMING_SPEC.md",
      "purpose": "Canonical standalone gateway naming."
    },
    {
      "file": "RUST_CODE_SPEC.md",
      "path": "../../../sdkwork-specs/RUST_CODE_SPEC.md",
      "purpose": "Rust runtime-gateway dependency direction."
