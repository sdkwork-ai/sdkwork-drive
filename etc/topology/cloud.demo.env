SDKWORK_DRIVE_DEPLOYMENT_PROFILE=cloud
SDKWORK_DRIVE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DRIVE_PROFILE_ID=cloud.demo

# Cloud-hosted independent demo deployment, fully isolated from dev/test/staging/prod. Provisioned
# as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_drive_demo` and a
# dedicated Redis logical DB index so no cache key collides with another shared-redis environment.

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DRIVE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_DRIVE_APPLICATION_PUBLIC_HTTP_URL=https://drive-demo.sdkwork.com
SDKWORK_DRIVE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_DRIVE_ROOT_SCOPE_EVENT_CALLER_APP_ID=knowledgebase
SDKWORK_DRIVE_KNOWLEDGEBASE_EVENT_CALLBACK_URL=https://api-demo.sdkwork.com/internal/v3/api/knowledgebase/drive_events
SDKWORK_DRIVE_KNOWLEDGEBASE_EVENT_INGRESS_TOKEN_FILE=./.sdkwork/runtime/secrets/knowledgebase-event-ingress-token

# Isolation: dedicated Redis logical DB index on the shared Redis so hardcoded service prefixes
# never collide with dev/test/staging/prod.
SDKWORK_DRIVE_REDIS_URL=redis://127.0.0.1:6379/9
SDKWORK_DRIVE_REDIS_ENABLED=true

VITE_DRIVE_PC_DEPLOYMENT_PROFILE=cloud
VITE_DRIVE_PC_ENVIRONMENT=demo
VITE_DRIVE_PC_CONFIG_PROFILE=demo
VITE_DRIVE_PC_BUILD_MODE=demo
VITE_DRIVE_PC_RUNTIME_TARGET=desktop
VITE_DRIVE_PC_APPLICATION_PUBLIC_HTTP_URL=https://drive-demo.sdkwork.com
VITE_DRIVE_PC_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_DRIVE_PC_APPBASE_APP_API_BASE_URL=https://api-demo.sdkwork.com
VITE_DRIVE_PC_DRIVE_APP_API_BASE_URL=https://drive-demo.sdkwork.com
VITE_DRIVE_PC_APP_API_BASE_URL=https://drive-demo.sdkwork.com
VITE_DRIVE_PC_DRIVE_ADMIN_STORAGE_API_BASE_URL=https://drive-demo.sdkwork.com
VITE_DRIVE_PC_BACKEND_API_BASE_URL=https://drive-demo.sdkwork.com
