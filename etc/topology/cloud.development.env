
SDKWORK_DRIVE_DEPLOYMENT_PROFILE=cloud
SDKWORK_DRIVE_ENVIRONMENT=development
SDKWORK_DRIVE_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DRIVE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_DRIVE_APPLICATION_PUBLIC_HTTP_URL=http://drive-dev.sdkwork.com:3900
SDKWORK_DRIVE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_DRIVE_ROOT_SCOPE_EVENT_CALLER_APP_ID=knowledgebase
SDKWORK_DRIVE_KNOWLEDGEBASE_EVENT_CALLBACK_URL=https://api-dev.sdkwork.com/internal/v3/api/knowledgebase/drive_events
SDKWORK_DRIVE_KNOWLEDGEBASE_EVENT_INGRESS_TOKEN_FILE=./.sdkwork/runtime/secrets/knowledgebase-event-ingress-token

VITE_DRIVE_PC_DEPLOYMENT_PROFILE=cloud
VITE_DRIVE_PC_ENVIRONMENT=development
VITE_DRIVE_PC_CONFIG_PROFILE=dev
VITE_DRIVE_PC_BUILD_MODE=development
VITE_DRIVE_PC_RUNTIME_TARGET=desktop
VITE_DRIVE_PC_DEV_SAME_ORIGIN_API=true

VITE_DRIVE_PC_APPLICATION_PUBLIC_HTTP_URL=http://drive-dev.sdkwork.com:3900
VITE_DRIVE_PC_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_DRIVE_PC_APPBASE_APP_API_BASE_URL=https://api-dev.sdkwork.com
VITE_DRIVE_PC_DRIVE_APP_API_BASE_URL=http://drive-dev.sdkwork.com:3900
VITE_DRIVE_PC_APP_API_BASE_URL=http://drive-dev.sdkwork.com:3900
VITE_DRIVE_PC_DRIVE_ADMIN_STORAGE_API_BASE_URL=http://drive-dev.sdkwork.com:3900
VITE_DRIVE_PC_BACKEND_API_BASE_URL=http://drive-dev.sdkwork.com:3900


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
