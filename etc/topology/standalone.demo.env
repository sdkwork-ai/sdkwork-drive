SDKWORK_DRIVE_DEPLOYMENT_PROFILE=standalone
SDKWORK_DRIVE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DRIVE_PROFILE_ID=standalone.demo

# Independent demo deployment fully isolated from dev/test/staging/prod. Provisioned as its own
# deployment: dedicated PostgreSQL database/schema/user `sdkwork_drive_demo` and a dedicated Redis
# logical DB index so no cache key ever collides with another shared-redis environment.

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DRIVE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from existing dev/test/staging/prod origins).
SDKWORK_DRIVE_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3900
SDKWORK_DRIVE_APPLICATION_PUBLIC_HTTP_URL=http://drive-demo.sdkwork.com:3900
SDKWORK_DRIVE_STANDALONE_GATEWAY_ENVIRONMENT=demo
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true

# Isolation: dedicated Redis logical DB index on the shared Redis so hardcoded service prefixes
# never collide with dev/test/staging/prod.
SDKWORK_DRIVE_REDIS_URL=redis://127.0.0.1:6379/9
SDKWORK_DRIVE_REDIS_ENABLED=true

VITE_DRIVE_PC_DEPLOYMENT_PROFILE=standalone
VITE_DRIVE_PC_ENVIRONMENT=demo
VITE_DRIVE_PC_CONFIG_PROFILE=demo
VITE_DRIVE_PC_BUILD_MODE=demo
VITE_DRIVE_PC_RUNTIME_TARGET=desktop
VITE_DRIVE_PC_APPLICATION_PUBLIC_HTTP_URL=http://drive-demo.sdkwork.com:3900
VITE_DRIVE_PC_APPBASE_APP_API_BASE_URL=http://drive-demo.sdkwork.com:3900
VITE_DRIVE_PC_DRIVE_APP_API_BASE_URL=http://drive-demo.sdkwork.com:3900
VITE_DRIVE_PC_APP_API_BASE_URL=http://drive-demo.sdkwork.com:3900
VITE_DRIVE_PC_DRIVE_ADMIN_STORAGE_API_BASE_URL=http://drive-demo.sdkwork.com:3900
VITE_DRIVE_PC_BACKEND_API_BASE_URL=http://drive-demo.sdkwork.com:3900

# Platform API gateway: drive standalone exposes its own edge on the gateway bind.
VITE_DRIVE_PC_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_DRIVE_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=https://drive-demo.sdkwork.com,http://drive-demo.sdkwork.com,https://drive-demo.birdcoder.com,http://drive-demo.birdcoder.com,https://drive-demo.dtupay.com,http://drive-demo.dtupay.com,https://drive-demo.noaper.com,http://drive-demo.noaper.com,https://drive-demo.sdkwork.cn,http://drive-demo.sdkwork.cn,https://drive-demo.birdcoder.cn,http://drive-demo.birdcoder.cn,https://drive-demo.dtupay.cn,http://drive-demo.dtupay.cn,https://drive-demo.noaper.cn,http://drive-demo.noaper.cn,https://drive-demo.skubc.com,http://drive-demo.skubc.com,https://drive-demo.skubc.cn,http://drive-demo.skubc.cn,https://drive-demo.zowalk.com,http://drive-demo.zowalk.com,https://drive-demo.zowalk.cn,http://drive-demo.zowalk.cn,https://drive-demo.offer86.com,http://drive-demo.offer86.com,https://drive-demo.offer86.cn,http://drive-demo.offer86.cn,https://drive-demo.86offer.com,http://drive-demo.86offer.com,https://drive-demo.86offer.cn,http://drive-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
