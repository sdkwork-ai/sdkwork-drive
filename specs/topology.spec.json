{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-drive",
  "applicationCode": "drive",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production",
        "demo"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production",
    "gatewayBind": "127.0.0.1:3900"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.demo": "etc/topology/standalone.demo.env",
    "cloud.demo": "etc/topology/cloud.demo.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_DRIVE_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_DRIVE_ENVIRONMENT",
    "profileId": "SDKWORK_DRIVE_PROFILE_ID",
    "clientDeploymentProfile": "VITE_DRIVE_PC_DEPLOYMENT_PROFILE",
    "standaloneGatewayBind": "SDKWORK_DRIVE_APPLICATION_PUBLIC_INGRESS_BIND",
    "standaloneGatewayConfig": "SDKWORK_DRIVE_STANDALONE_GATEWAY_CONFIG",
    "standaloneGatewayEnvironment": "SDKWORK_DRIVE_STANDALONE_GATEWAY_ENVIRONMENT",
    "clientApiGatewayBaseUrl": "VITE_DRIVE_PC_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "SDKWORK_DRIVE_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_DRIVE_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_DRIVE_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_DRIVE_PC_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_DRIVE_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_DRIVE_PC_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
