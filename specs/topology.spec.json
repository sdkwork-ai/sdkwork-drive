  "components": {
    "standaloneGateway": {
      "crate": "sdkwork-api-drive-standalone-gateway",
      "binary": "sdkwork-api-drive-standalone-gateway",
      "configGlob": "etc/sdkwork-api-drive-standalone-gateway.{profile}.toml"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "standalone-gateway",
            "role": "api-standalone-gateway",
            "script": "_sdkwork:gateway:standalone",
            "required": true
          },
          {
            "id": "drive-browser",
            "role": "client",
            "script": "_sdkwork:client:browser:standalone",
            "runtimeTargets": [
              "browser"
            ],
            "required": true
          },
          {
            "id": "drive-desktop",
            "role": "client",
            "script": "_sdkwork:client:desktop:standalone",
            "runtimeTargets": [
              "desktop"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": []
      },
      "standalone.test": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "standalone.staging": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "cloud.development": {
        "processes": [
          {
            "id": "drive-browser",
            "role": "client",
            "script": "_sdkwork:client:browser:cloud",
            "runtimeTargets": [
              "browser"
            ],
            "required": true
          },
          {
            "id": "drive-desktop",
            "role": "client",
            "script": "_sdkwork:client:desktop:cloud",
            "runtimeTargets": [
              "desktop"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.test": {
        "processes": [],
        "healthSurfaces": []
      },
      "cloud.staging": {
        "processes": [],
        "healthSurfaces": []
      },
      "cloud.production": {
        "processes": [],
        "healthSurfaces": []
      },
      "standalone.production": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "standalone.demo": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "cloud.demo": {
        "processes": [],
        "healthSurfaces": []
      }
    }
  },
  "packaging": {
    "cloudConfigFiles": [],
    "targets": [
      {
        "id": "linux-x64-application-public-ingress-tar-gz",
        "profile": "application-public-ingress",
        "platform": "linux",
        "architecture": "x64",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "rustTarget": "x86_64-unknown-linux-gnu",
        "outputGlob": "dist/standalone-gateway/sdkwork-api-drive-standalone-gateway-*-linux-x64-standalone-gateway.tar.gz"
      },
      {
        "id": "linux-arm64-application-public-ingress-tar-gz",
        "profile": "application-public-ingress",
        "platform": "linux",
        "architecture": "arm64",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "rustTarget": "aarch64-unknown-linux-gnu",
        "outputGlob": "dist/standalone-gateway/sdkwork-api-drive-standalone-gateway-*-linux-arm64-standalone-gateway.tar.gz"
      },
      {
        "id": "windows-x64-application-public-ingress-tar-gz",
        "profile": "application-public-ingress",
        "platform": "windows",
        "architecture": "x64",
        "formats": [
          "tar.gz"
        ],
        "runner": "windows-latest",
        "rustTarget": "x86_64-pc-windows-msvc",
        "outputGlob": "dist/standalone-gateway/sdkwork-api-drive-standalone-gateway-*-windows-x64-standalone-gateway.tar.gz"
      },
      {
        "id": "windows-arm64-application-public-ingress-tar-gz",
        "profile": "application-public-ingress",
        "platform": "windows",
        "architecture": "arm64",
        "formats": [
          "tar.gz"
        ],
        "runner": "windows-latest",
        "rustTarget": "aarch64-pc-windows-msvc",
        "outputGlob": "dist/standalone-gateway/sdkwork-api-drive-standalone-gateway-*-windows-arm64-standalone-gateway.tar.gz"
      },
      {
        "id": "macos-x64-application-public-ingress-tar-gz",
        "profile": "application-public-ingress",
        "platform": "macos",
        "architecture": "x64",
        "formats": [
          "tar.gz"
        ],
        "runner": "macos-14",
        "rustTarget": "x86_64-apple-darwin",
        "outputGlob": "dist/standalone-gateway/sdkwork-api-drive-standalone-gateway-*-macos-x64-standalone-gateway.tar.gz"
      },
      {
        "id": "macos-arm64-application-public-ingress-tar-gz",
        "profile": "application-public-ingress",
        "platform": "macos",
        "architecture": "arm64",
        "formats": [
          "tar.gz"
        ],
        "runner": "macos-14",
        "rustTarget": "aarch64-apple-darwin",
        "outputGlob": "dist/standalone-gateway/sdkwork-api-drive-standalone-gateway-*-macos-arm64-standalone-gateway.tar.gz"
      },
      {
        "id": "platform-config-bundle-tar-gz",
        "profile": "platform-config-bundle",
        "platform": "all",
        "architecture": "all",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "outputGlob": "dist/cloud-config/sdkwork-drive-api-gateway-config-*.tar.gz"
      }
    ]
  },
  "scripts": {
    "driveDev": "scripts/drive-dev.mjs",
    "driveBuild": "scripts/drive-build.mjs",
    "gatewayStandaloneRun": "scripts/gateway-standalone-run.mjs",
    "gatewayStandalonePack": "scripts/gateway-standalone-pack.mjs"
  },
  "retired": {
    "vocabulary": {
      "hosting": [
        "self-hosted",
        "cloud-hosted"
      ],
      "deploymentMode": [
        "web",
        "desktop",
        "tablet-ipados",
        "tablet-android",
        "server",
        "container",
        "saas",
        "private",
        "local",
        "test"
      ]
    },
    "envKeys": [
      "SDKWORK_DRIVE_HOSTING",
      "SDKWORK_DRIVE_TOPOLOGY",
      "VITE_DRIVE_PC_HOSTING",
      "VITE_DRIVE_PC_TOPOLOGY",
      "VITE_DRIVE_PC_DEPLOYMENT_MODE",
      "VITE_DRIVE_PC_API_GATEWAY_BASE_URL"
    ],
    "profileIds": [
      "self-hosted.unified-process.development",
      "self-hosted.split-services.development",
      "self-hosted.unified-process.production",
      "cloud-hosted.split-services.development",
      "cloud-hosted.split-services.production"
    ],
    "packagingProfiles": [
